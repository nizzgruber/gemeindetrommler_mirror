rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Fotos von News, Mängeln und Ideen
    match /{collection}/{userId}/{fileName} {
      // Jeder darf Bilder in der App laden/ansehen
      allow read: if true;
      
      // Nur angemeldete Nutzer dürfen Fotos hochladen (max. 10 MB, nur Bilder)
      allow create, update: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
        
      // Fotos löschen beim Entfernen eines Beitrags (durch Verfasser oder Admin)
      allow delete: if request.auth != null;
    }
  }
}
